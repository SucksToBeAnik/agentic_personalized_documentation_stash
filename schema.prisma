generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  summary   String
  tags      String[]
  category  String
  document  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
